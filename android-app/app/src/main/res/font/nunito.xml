<?xml version="1.0" encoding="utf-8"?>
<!--
    FILE: res/font/nunito.xml
    Copy file này vào thư mục res/font/ trong project.
    Xem HUONG_DAN_NUNITO_FONT.txt để biết cách tạo thư mục và copy file .ttf.
-->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/nunito_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/nunito_regular"/>

    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/nunito_semibold"
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/nunito_semibold"/>

    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/nunito_bold"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/nunito_bold"/>

</font-family>
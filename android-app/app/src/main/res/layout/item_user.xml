<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="16dp"
    android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/tv_username"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="16sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_role"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#1E88E5" android:layout_marginEnd="8dp"/>
    <TextView android:id="@+id/tv_status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#43A047"/>
</LinearLayout>